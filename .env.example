# Trading OS Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.

JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_ISSUER=HopeTradingOS

KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_WEBSOCKET=wss://ws.kraken.com/v2
MARKET_DATA_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:17085,http://127.0.0.1:17085,http://localhost:4200,http://127.0.0.1:4200
BROKER_MASTER_KEY=
BROKER_MASTER_KEY_VERSION=v1

# Service-to-service JWT signing/trust material.
# Leave these blank for ./scripts/bootstrap-local-env.sh to generate them.
# Use distinct Base64-encoded 32-byte keys for each trust relationship.
TRADING_CORE_SERVICE_JWT_SECRET=
BROKER_SERVICE_SERVICE_JWT_SECRET=
MARKET_INTELLIGENCE_SERVICE_JWT_SECRET=
TRADING_CORE_MI_SERVICE_JWT_SECRET=
TRADING_CORE_MARKET_DATA_SERVICE_JWT_SECRET=
MARKET_INTELLIGENCE_MARKET_DATA_SERVICE_JWT_SECRET=

# Market eligibility and Market Facts runtime policy.
MARKET_INTELLIGENCE_ELIGIBILITY_INTERVAL=ONE_HOUR
MARKET_INTELLIGENCE_ELIGIBILITY_ACTIVITY_WINDOW_MINUTES=180
MARKET_INTELLIGENCE_ELIGIBILITY_READINESS_LOOKBACK_CANDLES=24
MARKET_INTELLIGENCE_ELIGIBILITY_MINIMUM_COMPLETED_CANDLES=12
MARKET_INTELLIGENCE_ELIGIBILITY_MAX_OBSERVATION_AGE_SECONDS=7200
MARKET_INTELLIGENCE_MAX_MARKET_FACT_EVALUATIONS_PER_SCAN=10
MARKET_DATA_MARKET_FACTS_AUTHORIZED_CALLERS=trading-core,market-intelligence

SONAR_TOKEN=

# Economic calendar provider. XOOMAR is disabled by default. Free use requires visible
# attribution: "Data: XOOMAR" with a link to https://xoomar.com/markets/api/calendar.
NEWS_PROVIDER_ENABLED=false
NEWS_XOOMAR_ENABLED=false
NEWS_XOOMAR_BASE_URL=https://xoomar.com
NEWS_XOOMAR_POLL_INTERVAL=PT15M
NEWS_XOOMAR_LOOKBACK_DAYS=1
NEWS_XOOMAR_LOOKAHEAD_DAYS=7
