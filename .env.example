# Trading OS Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.

JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_ISSUER=HopeTradingOS

KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_WEBSOCKET=wss://ws.kraken.com/v2
MARKET_DATA_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:17085,http://127.0.0.1:17085,http://localhost:4200,http://127.0.0.1:4200
BROKER_MASTER_KEY=
BROKER_MASTER_KEY_VERSION=v1

# cTrader READ-ONLY runtime validation
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=http://localhost:17082/api/v1/broker-accounts/ctrader/authorization/callback
CTRADER_AUTHORIZATION_ENDPOINT=https://id.ctrader.com/my/settings/openapi/grantingaccess/
CTRADER_ENVIRONMENT=demo
CTRADER_TOKEN_ENDPOINT=https://openapi.ctrader.com/apps/token
CTRADER_WEBSOCKET_ENDPOINT=wss://demo.ctraderapi.com:5036
CTRADER_AUTHORIZATION_STATE_TTL_SECONDS=600

# Market Data owns a separate read-only OAuth authorization.
CTRADER_MARKET_DATA_ENABLED=false
CTRADER_MARKET_DATA_BOOTSTRAP_ENABLED=false
CTRADER_MARKET_DATA_ENVIRONMENT=demo
CTRADER_MARKET_DATA_EXTERNAL_ACCOUNT_ID=
CTRADER_MARKET_DATA_AUTHORIZATION_ENDPOINT=https://id.ctrader.com/my/settings/openapi/grantingaccess/
CTRADER_MARKET_DATA_REDIRECT_URI=http://localhost:17083/api/v1/ctrader/authorization/callback
CTRADER_MARKET_DATA_AUTHORIZATION_STATE_TTL=PT10M
CTRADER_MARKET_DATA_CLIENT_ID=
CTRADER_MARKET_DATA_CLIENT_SECRET=
CTRADER_MARKET_DATA_TOKEN_ENDPOINT=https://openapi.ctrader.com/apps/token
CTRADER_MARKET_DATA_WEBSOCKET_ENDPOINT=wss://demo.ctraderapi.com:5036
CTRADER_MARKET_DATA_SYMBOL_MAPPING_EURUSD=EUR/USD
CTRADER_MARKET_DATA_SYMBOL_MAPPING_GBPUSD=GBP/USD
CTRADER_MARKET_DATA_SYMBOL_MAPPING_XAUUSD=XAU/USD
CTRADER_MARKET_DATA_SYMBOL_MAPPING_US30_CASH=US30/USD
CTRADER_MARKET_DATA_SYMBOL_PRODUCT_TYPE_US30_CASH=CFD
CTRADER_MARKET_DATA_TOKEN_MASTER_KEY=
CTRADER_MARKET_DATA_TOKEN_KEY_VERSION=v1

# Service-to-service JWT signing/trust material.
# Leave these blank for ./scripts/bootstrap-local-env.sh to generate them.
# Use distinct Base64-encoded 32-byte keys for each trust relationship.
TRADING_CORE_SERVICE_JWT_SECRET=
BROKER_SERVICE_SERVICE_JWT_SECRET=
MARKET_INTELLIGENCE_SERVICE_JWT_SECRET=
MARKET_INTELLIGENCE_BROKER_SERVICE_JWT_SECRET=
TRADING_CORE_MI_SERVICE_JWT_SECRET=
TRADING_CORE_MARKET_DATA_SERVICE_JWT_SECRET=
MARKET_INTELLIGENCE_MARKET_DATA_SERVICE_JWT_SECRET=

# Market eligibility and Market Facts runtime policy.
MARKET_INTELLIGENCE_ELIGIBILITY_INTERVAL=ONE_HOUR
MARKET_INTELLIGENCE_ELIGIBILITY_ACTIVITY_WINDOW_MINUTES=180
MARKET_INTELLIGENCE_ELIGIBILITY_READINESS_LOOKBACK_CANDLES=24
MARKET_INTELLIGENCE_ELIGIBILITY_MINIMUM_COMPLETED_CANDLES=12
MARKET_INTELLIGENCE_ELIGIBILITY_MAX_OBSERVATION_AGE_SECONDS=7200
MARKET_INTELLIGENCE_MAX_MARKET_FACT_EVALUATIONS_PER_SCAN=10
MARKET_DATA_MARKET_FACTS_AUTHORIZED_CALLERS=trading-core,market-intelligence

SONAR_TOKEN=

# Economic calendar provider. XOOMAR is disabled by default. Free use requires visible
# attribution: "Data: XOOMAR" with a link to https://xoomar.com/markets/api/calendar.
NEWS_PROVIDER_ENABLED=true
NEWS_XOOMAR_ENABLED=true
NEWS_XOOMAR_BASE_URL=https://xoomar.com
NEWS_XOOMAR_POLL_INTERVAL=PT15M
NEWS_XOOMAR_LOOKBACK_DAYS=1
NEWS_XOOMAR_LOOKAHEAD_DAYS=7
